# AntiqueRide - Environment Configuration

# Application
NEXT_PUBLIC_APP_NAME="AntiqueRide"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_TAGLINE="Your Ride. Your Antique."
NEXT_PUBLIC_INITIAL_MUNICIPALITY="San Jose de Buenavista"

# Supabase (PostgreSQL + PostGIS + Auth + Realtime + Storage)
# When omitted, AntiqueRide runs in resilient local offline/mock mode for development and testing.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Map Tiles & Routing (OpenStreetMap Attribution Complying)
# Defaults to OpenStreetMap standard tile layers with proper caching headers
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@antiqueride.ph"

# Emergency Hotlines (Antique, Philippines)
NEXT_PUBLIC_EMERGENCY_PNP_SAN_JOSE="0998-598-6286"
NEXT_PUBLIC_EMERGENCY_PDRRMO_ANTIQUE="0917-817-0205"
NEXT_PUBLIC_EMERGENCY_HOTLINE="911"
