      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "TODA Driver Console",
      "short_name": "Driver Console",
      "description": "Open TODA tricycle operator shift and dispatch console",
      "url": "/driver",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Emergency Safety Desk",
      "short_name": "Safety Desk",
      "description": "Direct emergency hotlines for San Jose PNP, PDRRMO 911, and TMPSO",
      "url": "/offline",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
